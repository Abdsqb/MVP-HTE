# Copy to .env.local and fill in. Never commit .env.local.

# Which AI to use: "gemini" or "anthropic".
# If unset, Gemini is used when only GEMINI_API_KEY is filled in.
AI_PROVIDER=gemini

# Google Gemini (free key: https://aistudio.google.com/apikey)
# Note: on the free tier Google may use what you send to improve its products.
# Fine for the fictional sample PDFs; don't send real client data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
